# Twilio (required for real SMS / voice — trial accounts only send to verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# Optional per-contact overrides
TWILIO_TO_JENNY=
TWILIO_TO_MARK=

# Trial accounts cannot send custom SMS text (error 572006). Keep TWILIO_TRIAL=1
# to send a Twilio predefined template (phone still buzzes). Set TWILIO_TRIAL=0
# after you upgrade the account to send the real "Arthur is heading…" body.
TWILIO_TRIAL=1
TWILIO_TRIAL_TEMPLATE=sms_account_alerts

# Scan home: demo = schematic; live = wait for E2 map_ready (see docs/16-e3-portal.md)
MAP_SCAN_MODE=demo

# Compress ladder timers for demos (L3=8s, L4=16s)
LANTERN_FAST_LADDER=1

# Public base URL embedded in SMS ack links (use ngrok/cloudflare tunnel at venue)
ACK_BASE_URL=http://127.0.0.1:8000

# When run_spine.py hub is up, forward cloud publishes (ack/checkin) to the bus
# LANTERN_ORCH_PUBLISH_URL=http://127.0.0.1:9000

# On-demand Go2 camera for Night Watch (E2 serves DimOS cockpit/teleop — no SDK in /cloud)
# DOG_CAMERA_ENABLED=0
# DOG_CAMERA_URL=http://127.0.0.1:7780/
# Optional MJPEG (or similar) for same-origin proxy: GET /api/camera/stream
# DOG_CAMERA_STREAM_URL=

# For phone QR codes: also set cloud/web/.env.local
# VITE_PUBLIC_ORIGIN=https://YOUR-SUBDOMAIN.trycloudflare.com
# and point ACK_BASE_URL at the same HTTPS origin (Vite proxies /api/ack).
